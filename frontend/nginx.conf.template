# Sirve la aplicación Angular y hace de proxy de la API.
# El navegador ve frontend y API en el mismo origen: la cookie SameSite=Strict del refresh
# token funciona y no hace falta CORS. ${BACKEND_URL} se sustituye al arrancar el contenedor.
server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Documentación de la API (Swagger UI) también accesible desde la misma dirección
    location ~ ^/(swagger-ui|v3/api-docs) {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
    }

    # Ficheros con hash en el nombre: se pueden guardar en caché para siempre
    location ~* \.(js|css|woff2?|ico)$ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Rutas de Angular (/panel, /peluqueria-lola...): si no es un fichero, sirve index.html
    location / {
        try_files $uri $uri/ /index.html;
    }
}
