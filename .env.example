# Copia este fichero a .env y ajusta los valores. El .env nunca se sube al repositorio.
# Lo leen docker compose y el backend (spring.config.import en application.yml).

# --- Base de datos ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=reservas
DB_USERNAME=reservas
DB_PASSWORD=cambia-esta-contrasena

# --- Email (Mailpit en local) ---
MAIL_HOST=localhost
MAIL_PORT=1025
MAILPIT_UI_PORT=8025
MAIL_FROM=no-responder@reservas.local

# --- Backend ---
SERVER_PORT=8080
# Orígenes permitidos por CORS, separados por comas
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Autenticación ---
# Clave para firmar los JWT: mínimo 32 caracteres. Genera una con:
#   openssl rand -base64 48
JWT_SECRET=
# Atributo Secure de la cookie del refresh token. true en producción (HTTPS).
# Los navegadores aceptan cookies Secure en http://localhost, así que true también vale en local.
REFRESH_COOKIE_SECURE=true
